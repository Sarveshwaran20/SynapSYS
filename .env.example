# SynapSYS — Firebase Cloud Firestore Connection Template
# Copy to .env (at repository root or backend/.env) and fill in your Firebase project credentials.

# Google Cloud Firebase Project ID (from Firebase Console -> Project Settings)
FIREBASE_PROJECT_ID=synapsys-industrial

# Optional Web API Key (for client-side or REST API access)
FIREBASE_API_KEY=

# Optional Service Account / ID token for privileged server-side access
FIREBASE_AUTH_TOKEN=

# Optional Frontend Web Config
VITE_FIREBASE_PROJECT_ID=synapsys-industrial
VITE_FIREBASE_API_KEY=

# 2FA Security Email Dispatcher (Gmail SMTP)
# To deliver real 2FA emails to sarveshwaran.k2008@gmail.com, generate a 16-character
# Google App Password at https://myaccount.google.com/apppasswords and configure below:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=security@synapsys.industrial
SECURITY_ALERT_EMAIL=sarveshwaran.k2008@gmail.com
